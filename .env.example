# Supabase (names only — copy to .env.local for local dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres for migration tests in CI (set by workflow)
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: LLM for adaptive client replies (Groq or Gemini — no key = templated fallback)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Voice ladder (server-side only — never NEXT_PUBLIC_, never in the browser)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Kill switch: false = billed ElevenLabs path disabled (Web Speech only)
ELEVENLABS_ENABLED=
# Opt-in: true = agente ConvAI en la llamada. Vacío = micrófono del navegador
# + TTS por /api/voice/tts, que es el camino que usa la llamada hoy.
ELEVENLABS_CONVAI_ENABLED=
