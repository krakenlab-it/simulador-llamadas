# Supabase (names only — copy to .env.local for local dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres for migration tests in CI (set by workflow)
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Happy path: Vercel AI SDK through Vercel AI Gateway, serving DeepSeek.
# Default model: deepseek/deepseek-v4-flash
# On Vercel, OIDC is automatic. Locally: `vercel env pull .env.local`
# (writes VERCEL_OIDC_TOKEN) or set AI_GATEWAY_API_KEY.
# Names only — never commit values.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # written by `vercel env pull` — do not commit

# Optional fallbacks (not the default path)
GROQ_API_KEY=
GOOGLE_API_KEY=
# Optional last-resort only — do NOT use as the main path.
# Happy path is Gateway → DeepSeek, not a direct DeepSeek key.
DEEPSEEK_API_KEY=

# Voice ladder (server-side only — never NEXT_PUBLIC_, never in the browser)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Free-plan fallback when ELEVENLABS_VOICE_ID is a Voice Library id (402).
# Defaults to premade Sarah (EXAVITQu4vr4xnSDxMaL) — see ElevenLabs docs.
ELEVENLABS_PREMADE_VOICE_ID=
# Kill switch: false = billed ElevenLabs path disabled (Web Speech only)
ELEVENLABS_ENABLED=
# Opt-in: true = agente ConvAI en la llamada. Vacío = micrófono del navegador
# + TTS por /api/voice/tts, que es el camino que usa la llamada hoy.
ELEVENLABS_CONVAI_ENABLED=
